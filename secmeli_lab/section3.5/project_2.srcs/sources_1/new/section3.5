`timescale 1ns / 1ps

module challenge3_1(
    input  [7:0]  sw,
    output [1:0]  led
);

    // Odd number of 1s
    assign led[0] = sw[0] ^ sw[1] ^ sw[2] ^ sw[3] ^
                    sw[4] ^ sw[5] ^ sw[6] ^ sw[7];
                    
    // Even number of 1s
    assign led[1] = ~led[0];
            /*     bu yazým tarzý reduction xor diye geçiyor ce kodu böyle de yazabilirdik ^sw bütün switch deüerlerini xorluyor
                   ^sw == sw[0] ^ sw[1] ^ sw[2] ^ ... ^ sw[7]
                    assign led[0] = ^sw;   // odd
                    assign led[1] = ~^sw;  // even
            */

endmodule